{% extends 'layout.twig' %}
{% block title %}{{ book.id ? 'Edit' : 'Add' }} book{% endblock %}
{% block content %}

<h2 class="form-title">{{ book.id ? 'Edit book' : 'Add a new book' }}</h2>

{% if errors %}
  <ul class="errors">{% for m in errors %}<li>{{ m }}</li>{% endfor %}</ul>
{% endif %}

<form method="post" action="index.php?action=save" enctype="multipart/form-data" class="book-form">
  <input type="hidden" name="csrf" value="{{ csrf() }}">
  <input type="hidden" name="id" value="{{ book.id }}">

  <div class="form-grid">
    <div class="form-fields">
      <label>Title *
        <input name="title" value="{{ book.title }}" required maxlength="200">
      </label>
      <label>Author *
        <input name="author" value="{{ book.author }}" required maxlength="150">
      </label>
      <div class="row">
        <label>Genre *
          <select name="genre" required>
            <option value="">-- choose --</option>
            {% for g in genres %}
              <option value="{{ g }}" {% if book.genre == g %}selected{% endif %}>{{ g }}</option>
            {% endfor %}
            <option value="Sci-Fi"  {% if book.genre == 'Sci-Fi'  %}selected{% endif %}>Sci-Fi</option>
            <option value="Fantasy" {% if book.genre == 'Fantasy' %}selected{% endif %}>Fantasy</option>
            <option value="History" {% if book.genre == 'History' %}selected{% endif %}>History</option>
            <option value="Tech"    {% if book.genre == 'Tech'    %}selected{% endif %}>Tech</option>
            <option value="Romance" {% if book.genre == 'Romance' %}selected{% endif %}>Romance</option>
            <option value="Thriller"{% if book.genre == 'Thriller'%}selected{% endif %}>Thriller</option>
            <option value="Other"   {% if book.genre == 'Other'   %}selected{% endif %}>Other</option>
          </select>
        </label>
        <label>Year *
          <input type="number" name="year" value="{{ book.year }}" min="1000" max="{{ "now"|date("Y")+1 }}" required>
        </label>
      </div>
      <label>ISBN
        <input name="isbn" value="{{ book.isbn }}" maxlength="20" placeholder="9780441013593">
      </label>
      <label>Description
        <textarea name="description" rows="4">{{ book.description }}</textarea>
      </label>
      <label class="file-label">Cover image (JPG/PNG/WEBP, max 2 MB)
        <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" onchange="previewCover(this)">
      </label>
    </div>

    <aside class="cover-preview-wrap">
      <p class="preview-hint">Cover preview</p>
      <img id="cover-preview" class="cover-preview" src="{{ cover_src(book.cover) }}" alt="Cover preview">
      {% if book.cover %}
        <p class="remove-cover">
          <label><input type="checkbox" name="remove_cover" value="1"> Remove current cover</label>
        </p>
      {% endif %}
    </aside>
  </div>

  <div class="actions">
    <button type="submit" class="primary">Save book</button>
    <a href="index.php" class="btn-cancel">Cancel</a>
  </div>
</form>

{% endblock %}