{% extends 'layout.twig' %}
{% block title %}Sign up{% endblock %}
{% block content %}

<div class="auth-wrap">
  <div class="auth-card">
    <h2>Create an account</h2>
    <p class="auth-sub">Take 10 seconds to join the library.</p>

    {% if errors %}
      <ul class="errors">{% for m in errors %}<li>{{ m }}</li>{% endfor %}</ul>
    {% endif %}

    <form method="post" action="register.php" class="auth-form">
      <input type="hidden" name="csrf" value="{{ csrf() }}">
      <label>Username
        <input name="username" value="{{ old.username }}" required minlength="3" maxlength="30"
               pattern="[A-Za-z0-9_]+" autocomplete="username">
      </label>
      <label>Password (min 8 chars)
        <input type="password" name="password" required minlength="8" autocomplete="new-password">
      </label>
      <label>Confirm password
        <input type="password" name="password2" required minlength="8" autocomplete="new-password">
      </label>
      <button type="submit" class="primary block">Create account</button>
    </form>

    <p class="auth-foot">Already registered? <a href="login.php">Log in</a></p>
  </div>
</div>

{% endblock %}