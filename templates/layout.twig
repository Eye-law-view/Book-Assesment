<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}Book Library{% endblock %} — Book Library</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
<header>
  <h1><a href="index.php" style="color:inherit;text-decoration:none;">📚 Book Library</a></h1>
  <nav>
    <a href="index.php">Home</a>
    {% if current_user %}
      <a href="index.php?action=new">＋ Add book</a>
      <span class="user-chip">👤 {{ current_user.username }}</span>
      <a href="logout.php" class="logout">Logout</a>
    {% else %}
      <a href="login.php">Login</a>
      <a href="register.php">Sign up</a>
    {% endif %}
  </nav>
</header>
<main>{% block content %}{% endblock %}</main>
<script src="js/app.js" defer></script>
</body>
</html>